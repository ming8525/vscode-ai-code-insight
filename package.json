{
  "name": "ai-code-insight",
  "displayName": "AI code insight",
  "description": "",
  "version": "0.0.1-beta.0",
  "icon": "icon.png",
  "publisher": "ming8525",
  "repository": "https://github.com/ming8525/vscode-ai-code-insight",
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "main": "./dist/index.js",
  "contributes": {
    "languages": [
      {
        "id": "javascript",
        "extensions": [
          ".js",
          ".jsx",
          ".ts",
          ".tsx"
        ]
      }
    ],
    "commands": [
      {
        "command": "aiCodeInsight.reviewCode",
        "title": "Review Code",
        "category": "CodeInsight"
      },
      {
        "command": "aiCodeInsight.hideDiagnostic",
        "title": "Hide warning",
        "category": "CodeInsight"
      },
      {
        "command": "aiCodeInsight.hideAllDiagnostics",
        "title": "Hide warnings",
        "category": "CodeInsight"
      },
      {
        "command": "aiCodeInsight.clearDiagnostics",
        "title": "Clear cache",
        "category": "CodeInsight"
      }
    ],
    "submenus": [
      {
        "id": "aiCodeInsightMenu",
        "label": "Code Insight",
        "title": "Code Insight",
        "icon": "$(light-bulb)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "aiCodeInsightMenu",
          "group": "navigation",
          "when": "editorTextFocus"
        }
      ],
      "aiCodeInsightMenu": [
        {
          "command": "aiCodeInsight.reviewCode",
          "group": "1_review"
        },
        {
          "command": "aiCodeInsight.hideAllDiagnostics",
          "group": "2_diagnostics"
        },
        {
          "command": "aiCodeInsight.clearDiagnostics",
          "group": "2_diagnostics"
        }
      ]
    },
    "configuration": {
      "title": "AI Code Insight",
      "properties": {
        "aiCodeInsight.apiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API Key for AI Code Insight."
        },
        "aiCodeInsight.model": {
          "type": "string",
          "default": "gpt-4-1106-preview",
          "description": "The model of OpenAI to use for AI Code Insight."
        },
        "aiCodeInsight.maxLines": {
          "type": "number",
          "default": 200,
          "description": "The maximum number of lines of code that can be analyzed. Determined by the number of tokens that the model can handle."
        },
        "aiCodeInsight.maxReviews": {
          "type": "number",
          "default": 10,
          "description": "The maximum number of review suggestions that can be returned."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "package": "vsce package -o dist"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.97.0",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "eslint": "^9.19.0",
    "typescript": "^5.7.3",
    "vsce": "^2.15.0"
  }
}
